      "name": "DAY02_POST",
      "item": [
        {
          "name": "01_Create_User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();\r\n\r\npm.test(\"POST 상태 코드 201\", function(){\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"제목 일치 검증\", function(){\r\n    pm.expect(data.title).to.eql(\"SQA DAY2 Test\");\r\n});\r\n\r\npm.test(\"userId 일치 검증\", function(){\r\n    pm.expect(data.userId).to.eql(1);\r\n});\r\n\r\npm.test(\"생성 ID 존재 검증\", function(){\r\n    pm.expect(data.id).to.be.a(\"number\");\r\n});\r\n\r\nif(pm.response.code === 201 && Number.isInteger(data.id)){\r\n    pm.collectionVariables.set(\"created_id\", data.id);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"title\": \"SQA DAY2 Test\",\r\n    \"body\": \"API automation practice\",\r\n    \"userId\": 1\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/posts",
              "protocol": "https",
              "host": [
                "jsonplaceholder",
                "typicode",
                "com"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02_Get_User_Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();\nconst createdId = pm.collectionVariables.get(\"created_id\");\n\npm.test(\"GET 상태 코드 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"조회 ID 일치 검증\", function () {\n    pm.expect(data.id).to.eql(1);\n});\n\npm.test(\"userId 타입 검증\", function () {\n    pm.expect(data.userId).to.be.a(\"number\");\n});\n\npm.test(\"POST에서 저장한 ID 확인\", function () {\n    pm.expect(Number(createdId)).to.be.greaterThan(0);\n    pm.collectionVariables.unset(\"created_id\");\n});"
                ]
              }
            }
          ],
