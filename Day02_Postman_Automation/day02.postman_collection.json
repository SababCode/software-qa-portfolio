                  "pm.test(\"존재하지 않은 데이터는 404\", function(){\r\n    pm.response.to.have.status(404);\r\n});\r\n\r\npm.test(\"응답이 Json 형식인지 확인\", function(){\r\n    pm.response.to.be.json;\r\n});\r\n\r\npm.test(\"조회 결과 빈 객체인지 확인\", function(){\r\n    pm.expect(pm.response.json()).to.eql({});\r\n});"
